# DOSBox-X config template for OpenFA runtime tracing.
# Generated by scripts/10_dosbox_trace.sh; placeholders are substituted:
#   __SCRATCH__  -> build/dosbox/cdrive   (game dir where CONFIG.INI lives)
#   __ISO_DIR__  -> build/iso             (mounted as CD-ROM)
#   __EXE_DIR__  -> directory of the game executable on the CD
#   __EXE__      -> game executable file name
#   __LOGFILE__  -> build/traces/dosbox-x.log  (host file for the DOSBox-X log)
#
# This template contains no game content.

[sdl]
fullscreen = false
windowresolution = 1024x768

[cpu]
core = auto
cputype = auto
cycles = auto

[memsize]
memsize = 64

[render]
aspect = true

[audio]
# Keep audio disabled for reproducible tracing.
sbtype = none
gus = false
mpu401 = none

[log]
# All DOSBox-X log messages land here; without a logfile the logger
# discards everything after early init.
logfile = __LOGFILE__
# INT 21h / file-open logging: also enable the group severity if you need it
# (the per-group default is "debug", which captures these). The 08 script
# passes -log-int21 -log-fileio on the command line when run with --trace,
# which overrides these defaults.
int21 = false
fileio = false

[autoexec]
@echo OFF
mount c __SCRATCH__
mount d __ISO_DIR__ -t cdrom
c:
d:
cd __EXE_DIR__
__EXE__
exit
